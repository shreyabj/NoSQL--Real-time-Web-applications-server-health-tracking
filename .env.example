# Copy this file to .env (Copy-Item .env.example .env) and adjust if needed.
# Docker Compose reads .env automatically. Every value below also has a
# built-in default in docker-compose.yml, so .env is optional.

# Database name and connection string used by the backend container.
# "mongodb" is the Docker Compose service hostname (NOT localhost).
MONGO_DB_NAME=server_health_monitoring
MONGODB_URI=mongodb://mongodb:27017/server_health_monitoring

# CPU utilization threshold in percent
CPU_THRESHOLD=80

# Seed the 12 sample documents automatically when the input collection is empty
AUTO_SEED=true

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=5000
